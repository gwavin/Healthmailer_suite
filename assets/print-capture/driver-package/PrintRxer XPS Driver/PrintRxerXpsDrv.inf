[PRINTRX_XPS_FILES]
PrintRxer-pipelineconfig.xml
PrintRxerXpsDrv.gpd
PrintConfig.dll

[PRINTRX_XPS.Services]
AddService = , %SPSVCINST_ASSOCSERVICE%

[DestinationDirs]
