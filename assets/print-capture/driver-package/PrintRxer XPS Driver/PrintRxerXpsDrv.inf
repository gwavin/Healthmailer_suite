CatalogFile=PrintRxerXpsDrv.cat
DriverVer=03/24/2026,1.0.0.0

[Manufacturer]
"PrintRxer"=PrintRxer,NTamd64

[PrintRxer.NTamd64]
"PrintRxer XPS Driver" = PRINTRX_XPS,,PrintRxer_XPS_Driver

[PRINTRX_XPS]
CopyFiles=PRINTRX_XPS_FILES
ConfigFile=PrintConfig.dll
DataFile=PrintRxerXpsDrv.gpd
DriverFile=mxdwdrv.dll
