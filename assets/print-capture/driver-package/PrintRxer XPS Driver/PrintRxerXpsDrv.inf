CoreDriverDependencies={D20EA372-DD35-4950-9ED8-A6335AFE79F5}

[ControlFlags]
AlwaysExcludeFromSelect=*

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
Disk1 = "PrintRxer Driver Package"

[SourceDisksNames.amd64]
1 = %Disk1%,,,"amd64"
